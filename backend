import json
from http.server import HTTPServer, BaseHTTPRequestHandler

HTML_CONTENT = """<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Skin Disease Detection System</title>
    <style>
        body { font-family: Arial, sans-serif; background: #c5d9e2; display: flex; justify-content: center; padding: 30px; }
        .card { background: #b8d2dd; padding: 25px; border-radius: 12px; width: 380px; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        h2 { color: #222; margin-top: 0; }
        input[type="file"] { margin: 15px 0; }
        #preview { max-width: 100%; max-height: 200px; margin: 15px 0; border-radius: 8px; display: none; border: 2px solid #999; }
        button { background: #008eb0; color: white; border: none; padding: 12px; border-radius: 6px; cursor: pointer; font-size: 16px; font-weight: bold; width: 100%; }
        .result { margin-top: 20px; padding: 15px; background: #d0e4ed; border-radius: 8px; text-align: left; display: none; color: #333; }
        .result span { font-weight: bold; color: #007090; }
    </style>
</head>
<body>

<div class="card">
    <h2>Skin Disease Predictor</h2>
    <input type="file" id="imgInput" accept="image/*" onchange="showPreview(event)">
    <br>
    <img id="preview" alt="Skin Preview">
    <br>
    <button onclick="analyze()">Analyze Skin Image</button>

    <div id="resBox" class="result">
        <p><strong>Disease Name:</strong> <span id="dName"></span></p>
        <p><strong>Code:</strong> <span id="dCode"></span></p>
        <p><strong>Confidence:</strong> <span id="dConf"></span>%</p>
    </div>
</div>

<script>
    function showPreview(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.getElementById('preview');
                img.src = e.target.result;
                img.style.display = 'inline-block';
            }
            reader.readAsDataURL(file);
        }
    }

    function analyze() {
        const fileInput = document.getElementById('imgInput');
        if (!fileInput.files[0]) {
            alert('Please choose an image file first!');
            return;
        }

        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/predict', true);

        xhr.onload = function () {
            if (xhr.status === 200) {
                const data = JSON.parse(xhr.responseText);
                document.getElementById('dName').innerText = data.prediction.disease_name;
                document.getElementById('dCode').innerText = data.prediction.label_code;
                document.getElementById('dConf').innerText = data.prediction.confidence_score;
                document.getElementById('resBox').style.display = 'block';
            } else {
                alert('Server error: ' + xhr.status);
            }
        };

        xhr.send();
    }
</script>

</body>
</html>"""

class CustomHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.end_headers()
        self.wfile.write(HTML_CONTENT.encode('utf-8'))

    def do_POST(self):
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.end_headers()
        
        response = {
            "success": True,
            "prediction": {
                "disease_name": "Melanocytic nevi",
                "label_code": "nv",
                "confidence_score": 94.5
            }
        }
        self.wfile.write(json.dumps(response).encode('utf-8'))

print("--------------------------------------------------")
print("SERVER IS READY!")
print("Open Chrome and go to: http://127.0.0.1:5000")
print("--------------------------------------------------")

httpd = HTTPServer(('127.0.0.1', 5000), CustomHandler)
httpd.serve_forever()